{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Classic ASP",
  "scopeName": "text.html.classic-asp",
  "patterns": [
    { "include": "#asp-include" },
    { "include": "#html-comment" },
    { "include": "#embedded-block-comment-bridge" },
    { "include": "#asp-expression" },
    { "include": "#asp-directive" },
    { "include": "#asp-block" },
    { "include": "text.html.basic" }
  ],
  "injections": {
    "L:source.css": {
      "patterns": [
        { "include": "#css-property-at-rule" },
        { "include": "#asp-expression" },
        { "include": "#asp-directive" },
        { "include": "#asp-block" }
      ]
    },
    "L:source.js": {
      "patterns": [
        { "include": "#asp-expression" },
        { "include": "#asp-directive" },
        { "include": "#asp-block" }
      ]
    }
  },
  "repository": {
    "css-property-at-rule": {
      "name": "meta.at-rule.property.css",
      "begin": "(?i)(@property)\\s+(--[-_a-z0-9]+)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.at-rule.property.css" },
        "2": { "name": "variable.other.custom-property.css" },
        "3": { "name": "punctuation.section.block.begin.css" }
      },
      "end": "\\}|(?i)(?=</style\\s*>)",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.css" }
      },
      "patterns": [
        { "include": "#asp-expression" },
        { "include": "#asp-directive" },
        { "include": "#asp-block" },
        { "include": "#css-property-descriptor" },
        { "include": "source.css#comment-block" }
      ]
    },
    "css-property-descriptor": {
      "name": "meta.property-value.css",
      "begin": "(?i)\\b(syntax|inherits|initial-value)\\b(\\s*)(:)",
      "beginCaptures": {
        "1": { "name": "support.type.property-name.css" },
        "3": { "name": "punctuation.separator.key-value.css" }
      },
      "end": ";|(?=\\}|(?i:</style\\s*>))",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.rule.css" }
      },
      "patterns": [
        { "include": "#asp-expression" },
        { "include": "#asp-directive" },
        { "include": "#asp-block" },
        {
          "match": "(?i)\\b(true|false)\\b",
          "name": "constant.language.boolean.css"
        },
        { "include": "source.css#property-values" }
      ]
    },
    "html-comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "patterns": [
        { "include": "#asp-expression" },
        { "include": "#asp-directive" },
        { "include": "#asp-block" }
      ]
    },
    "embedded-block-comment-bridge": {
      "name": "comment.block.css",
      "begin": "(?<=-->)\\/\\*",
      "end": "\\*\\/(?=<!--)"
    },
    "asp-include": {
      "name": "comment.block.html meta.include.asp",
      "begin": "<!--\\s*(#include)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.include.asp" }
      },
      "end": "-->",
      "patterns": [
        {
          "match": "\\b(file|virtual)\\b\\s*(=)\\s*(\"[^\"]*\"|'[^']*'|[^\\s>]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.include.asp" },
            "2": { "name": "punctuation.separator.key-value.include.asp" },
            "3": { "name": "string.quoted.include.asp" }
          }
        }
      ]
    },
    "asp-expression": {
      "name": "source.vbscript.embedded.asp.expression",
      "begin": "<%=",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.asp" }
      },
      "end": "%>",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.asp" }
      },
      "patterns": [{ "include": "#asp-vbscript" }]
    },
    "asp-directive": {
      "name": "meta.directive.asp",
      "begin": "<%@",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.asp" }
      },
      "end": "%>",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.asp" }
      },
      "patterns": [{ "include": "#asp-directive-content" }]
    },
    "asp-directive-content": {
      "patterns": [
        {
          "match": "(?i)\\b(Language|CodePage|LCID|Transaction|EnableSessionState)\\b",
          "name": "entity.other.attribute-name.directive.asp"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.directive.asp"
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.directive.asp" }
          },
          "end": "\"|(?=%>)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.directive.asp" }
          },
          "name": "string.quoted.double.directive.asp"
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.directive.asp" }
          },
          "end": "'|(?=%>)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.directive.asp" }
          },
          "name": "string.quoted.single.directive.asp"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.directive.asp"
        },
        {
          "match": "(?i)\\b(VBScript|JScript|JavaScript|True|False|Required|Requires_New|Supported|Not_Supported)\\b",
          "name": "constant.language.directive.asp"
        }
      ]
    },
    "asp-block": {
      "name": "source.vbscript.embedded.asp",
      "begin": "<%",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.asp" }
      },
      "end": "%>",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.asp" }
      },
      "patterns": [{ "include": "#asp-vbscript" }]
    },
    "asp-vbscript": {
      "patterns": [
        { "include": "#asp-vbscript-rem-comment" },
        { "include": "#asp-vbscript-string" },
        { "include": "#asp-vbscript-documentation-comment" },
        { "include": "#asp-vbscript-annotation-comment" },
        { "include": "#asp-vbscript-apostrophe-comment" },
        { "include": "source.vbscript" }
      ]
    },
    "asp-vbscript-rem-comment": {
      "begin": "(?i)(?:^|(?<=<%)|(?<=:))[\\t ]*Rem\\b",
      "beginCaptures": {
        "0": { "name": "comment.line.rem.vbscript" }
      },
      "end": "(?=%>)|$",
      "name": "comment.line.rem.vbscript"
    },
    "asp-vbscript-string": {
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.vbscript" }
      },
      "end": "\"|(?=%>)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.vbscript" }
      },
      "name": "string.quoted.double.vbscript"
    },
    "asp-vbscript-documentation-comment": {
      "begin": "(?:(?:^|(?<=<%)|(?<=:))[\\t ]*)?(''')[\\t ]?",
      "beginCaptures": {
        "1": { "name": "comment.line.documentation.vbscript" }
      },
      "end": "(?=%>)|$",
      "name": "comment.line.documentation.vbscript",
      "patterns": [
        { "include": "source.vbscript#documentation-tag" },
        { "include": "source.vbscript#documentation-entity" },
        {
          "match": "[^<&\\n\\r]+",
          "name": "string.unquoted.documentation.vbscript"
        }
      ]
    },
    "asp-vbscript-annotation-comment": {
      "begin": "(?:(?:^|(?<=<%)|(?<=:))[\\t ]*)?(')[\\t ]*(?=@(?:type|param|returns|member)\\b)",
      "beginCaptures": {
        "1": { "name": "comment.line.annotation.vbscript" }
      },
      "end": "(?=%>)|$",
      "name": "comment.line.annotation.vbscript",
      "patterns": [{ "include": "source.vbscript#annotation-comment" }]
    },
    "asp-vbscript-apostrophe-comment": {
      "begin": "(?:(?:^|(?<=<%)|(?<=:))[\\t ]*)?(')",
      "beginCaptures": {
        "0": { "name": "comment.line.apostrophe.vbscript" }
      },
      "end": "(?=%>)|$",
      "name": "comment.line.apostrophe.vbscript"
    }
  }
}
