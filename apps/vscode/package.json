{
  "name": "classic-asp-lsp",
  "displayName": "Classic ASP LSP",
  "version": "0.12.6",
  "private": true,
  "description": "%extension.description%",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "asp",
    "classic asp",
    "language server",
    "mixin",
    "vbscript"
  ],
  "homepage": "https://github.com/yottonoko/classic-web-system-lsp#readme",
  "bugs": {
    "url": "https://github.com/yottonoko/classic-web-system-lsp/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yottonoko/classic-web-system-lsp.git"
  },
  "qna": false,
  "publisher": "yottonoko",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --noEmit -p tsconfig.json && node scripts/bundle-extension.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test --deny-warnings",
    "package:vsix": "pnpm run build && vsce package --no-dependencies --follow-symlinks",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "rolldown": "^1.2.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "classic-asp",
        "aliases": [
          "Classic ASP",
          "classic-asp",
          "ASP"
        ],
        "extensions": [
          ".asp",
          ".asa",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vbscript",
        "aliases": [
          "VBScript",
          "vbscript",
          "VBA"
        ],
        "extensions": [
          ".vbs",
          ".vba",
          ".bas",
          ".cls",
          ".frm"
        ],
        "configuration": "./vbscript-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "classic-asp",
        "scopeName": "text.html.classic-asp",
        "path": "./syntaxes/classic-asp.tmLanguage.json",
        "embeddedLanguages": {
          "source.vbscript.embedded.asp": "vbscript",
          "source.vbscript.embedded.asp.expression": "vbscript",
          "source.css.embedded.html": "css",
          "source.js": "javascript",
          "source.css": "css",
          "text.html.basic": "html"
        }
      },
      {
        "scopeName": "classic-asp.tag-injection",
        "path": "./syntaxes/classic-asp-tag-injection.tmLanguage.json",
        "injectTo": [
          "text.html.classic-asp"
        ],
        "embeddedLanguages": {
          "source.vbscript.embedded.asp": "vbscript",
          "source.vbscript.embedded.asp.expression": "vbscript",
          "source.css.embedded.html": "css"
        }
      },
      {
        "language": "vbscript",
        "scopeName": "source.vbscript",
        "path": "./syntaxes/vbscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "aspLsp.restartServer",
        "title": "%command.restartServer.title%"
      },
      {
        "command": "aspLsp.clearCache",
        "title": "%command.clearCache.title%"
      },
      {
        "command": "aspLsp.toggleLineComment",
        "title": "%command.toggleLineComment.title%"
      },
      {
        "command": "aspLsp.toggleBlockComment",
        "title": "%command.toggleBlockComment.title%"
      },
      {
        "command": "mixin.showReferences",
        "title": "%command.showReferences.title%"
      }
    ],
    "keybindings": [
      {
        "command": "aspLsp.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && editorLangId == classic-asp"
      },
      {
        "command": "aspLsp.toggleBlockComment",
        "key": "shift+alt+a",
        "mac": "shift+alt+a",
        "when": "editorTextFocus && editorLangId == classic-asp"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mixin.showReferences",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "aspLsp.toggleLineComment",
          "when": "editorTextFocus && editorLangId == classic-asp",
          "group": "1_modification"
        },
        {
          "command": "aspLsp.toggleBlockComment",
          "when": "editorTextFocus && editorLangId == classic-asp",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "aspLsp.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.server.path.description%"
        },
        "aspLsp.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.server.extraArgs.description%"
        },
        "aspLsp.codeLens.references": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.references.description%"
        },
        "aspLsp.codeLens.includes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.includes.description%"
        },
        "aspLsp.codeLens.crossFileReferences": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.codeLens.crossFileReferences.description%"
        },
        "aspLsp.inlayHints.variableTypes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.variableTypes.description%"
        },
        "aspLsp.inlayHints.returnTypes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.returnTypes.description%"
        },
        "aspLsp.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.parameterNames.description%"
        },
        "aspLsp.inlayHints.scopeMarkers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.scopeMarkers.description%"
        },
        "aspLsp.onTypeFormatting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.onTypeFormatting.description%"
        },
        "aspLsp.html.linkedEditing": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.html.linkedEditing.description%"
        },
        "aspLsp.js.jsdocTypeStyle": {
          "type": "string",
          "enum": [
            "typescript",
            "jsdoc"
          ],
          "default": "typescript",
          "markdownDescription": "%config.js.jsdocTypeStyle.description%"
        },
        "aspLsp.io.networkMode": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "markdownDescription": "%config.io.networkMode.description%"
        },
        "aspLsp.io.statTtlMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "markdownDescription": "%config.io.statTtlMs.description%"
        },
        "aspLsp.io.diskCache": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.io.diskCache.description%"
        },
        "aspLsp.workspace.includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.{asp,asa,inc,vbs}"
          ],
          "description": "%config.workspace.includes.description%"
        },
        "aspLsp.workspace.excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.workspace.excludes.description%"
        },
        "aspLsp.workspace.respectGitIgnore": {
          "type": "boolean",
          "default": false,
          "description": "%config.workspace.respectGitIgnore.description%"
        },
        "aspLsp.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.enabled.description%"
        },
        "aspLsp.lint.groups.security": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.groups.security.description%"
        },
        "aspLsp.lint.groups.correctness": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.groups.correctness.description%"
        },
        "aspLsp.lint.groups.style": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.groups.style.description%"
        },
        "aspLsp.lint.rules.asp/unencoded-output": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.asp.unencoded-output.description%"
        },
        "aspLsp.lint.rules.asp/sql-concat": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.asp.sql-concat.description%"
        },
        "aspLsp.lint.rules.vb/undeclared-var": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.undeclared-var.description%"
        },
        "aspLsp.lint.rules.vb/missing-set": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.missing-set.description%"
        },
        "aspLsp.lint.rules.vb/unreachable": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.unreachable.description%"
        },
        "aspLsp.lint.rules.vb/on-error-resume-next": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.on-error-resume-next.description%"
        },
        "aspLsp.lint.rules.vb/option-explicit": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.option-explicit.description%"
        },
        "aspLsp.lint.rules.vb/unused-var": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.unused-var.description%"
        },
        "aspLsp.lint.rules.vb/goto-legacy": {
          "type": "string",
          "enum": [
            "default",
            "off",
            "hint",
            "info",
            "warning",
            "error"
          ],
          "default": "default",
          "description": "%config.lint.rules.vb.goto-legacy.description%"
        },
        "aspLsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace.server.description%"
        }
      }
    },
    "configurationDefaults": {
      "[classic-asp]": {
        "files.autoGuessEncoding": true,
        "editor.linkedEditing": true
      },
      "[vbscript]": {
        "files.autoGuessEncoding": true
      }
    }
  },
  "activationEvents": [
    "onLanguage:classic-asp",
    "onLanguage:vbscript"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.91.0"
  }
}
